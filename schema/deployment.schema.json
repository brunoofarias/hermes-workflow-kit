{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-workflow-kit/deployment.schema.json",
  "title": "Hermes Workflow Kit deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment", "organizations"],
  "properties": {
    "schema_version": {"const": 1},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "version", "author", "license", "hermes_requires", "reviewer_label", "agent_language", "model", "limits"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "display_name": {"$ref": "#/$defs/nonEmpty"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "author": {"$ref": "#/$defs/nonEmpty"},
        "license": {"$ref": "#/$defs/nonEmpty"},
        "hermes_requires": {"$ref": "#/$defs/nonEmpty"},
        "reviewer_label": {"$ref": "#/$defs/nonEmpty"},
        "agent_language": {"$ref": "#/$defs/nonEmpty"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name", "reasoning_effort"],
          "properties": {
            "provider": {"$ref": "#/$defs/nonEmpty"},
            "name": {"$ref": "#/$defs/nonEmpty"},
            "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_in_progress", "max_in_progress_per_profile", "failure_limit"],
          "properties": {
            "max_in_progress": {"type": "integer", "minimum": 1},
            "max_in_progress_per_profile": {"type": "integer", "minimum": 1},
            "failure_limit": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "display_name", "profile_prefix", "board"],
        "properties": {
          "slug": {"$ref": "#/$defs/slug"},
          "display_name": {"$ref": "#/$defs/nonEmpty"},
          "profile_prefix": {"$ref": "#/$defs/slug"},
          "board": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slug", "name", "description", "icon", "color"],
            "properties": {
              "slug": {"$ref": "#/$defs/slug"},
              "name": {"$ref": "#/$defs/nonEmpty"},
              "description": {"$ref": "#/$defs/nonEmpty"},
              "icon": {"type": "string", "minLength": 1, "maxLength": 8},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
            }
          },
          "additional_environment_requirements": {
            "type": "array",
            "items": {"$ref": "#/$defs/environmentRequirement"}
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "environmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "description": {"$ref": "#/$defs/nonEmpty"},
        "required": {"type": "boolean"}
      }
    }
  }
}
